@@ -53,6 +53,16 @@
 // queso error handling
 #include <queso/asserts.h>
 
+// On Windows (UCRT) time_t is 64-bit while struct timeval carries tv_sec as
+// long, so ctime(&tv.tv_sec) does not compile there. ctime() returns a static
+// buffer, so feeding it a local time_t copy is safe and is behavior-identical
+// on Linux/macOS.
+static char *queso_ctime(const struct timeval * tv)
+{
+  time_t sec = tv->tv_sec;
+  return ctime(&sec);
+}
+
